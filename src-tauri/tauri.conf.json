{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe SSH",
  "version": "0.1.0",
  "identifier": "dev.vibessh.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5273",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Vibe SSH",
        "width": 1360,
        "height": 860,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026",
    "category": "DeveloperTool",
    "shortDescription": "Terminal, SFTP & tunnel workbench",
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
